<Page
    x:Class="ModernCSharp.WinUIApp.Views.BlankPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0">
            <TextBlock Text="Select file type:" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <RadioButtons
                Header="Order File Options">
                <RadioButton
                    Content="Json Order"
                    GroupName="FileTypeGroup"
                    IsChecked="{x:Bind ViewModel.SelectedFileType, Mode=TwoWay, Converter={StaticResource FileTypeConverter}, ConverterParameter=OrderJSON}"/>
                <RadioButton Content="Csv Order"
                    GroupName="FileTypeGroup"
                    IsChecked="{x:Bind ViewModel.SelectedFileType, Mode=TwoWay, Converter={StaticResource FileTypeConverter}, ConverterParameter=OrderCSV}"/>
                <RadioButton
                    Content="Excel Order"
                    GroupName="FileTypeGroup"
                    IsChecked="{x:Bind ViewModel.SelectedFileType, Mode=TwoWay, Converter={StaticResource FileTypeConverter}, ConverterParameter=OrderEXCEL}"/>
            </RadioButtons>
        </StackPanel>

        <Button 
            x:Name="OpenOrderFileButton"
            Grid.Row="1"
            Click="OpenOrderFileButton_Click">
            Open
        </Button>
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal">
            <TextBlock
                x:Name="OrderFilePathTextBlock"
                TextWrapping="Wrap" 
                Padding="20,5,0,0"/>
            <ProgressBar
                Width="100"
                Height="100"
                Minimum="0"
                Maximum="100"
                Value="{x:Bind ViewModel.CurrentProgress, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ProgressBarVisibility, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"/>
            <ProgressRing
                Width="100"
                Height="100"
                Minimum="0"
                Maximum="100"
                IsIndeterminate="False"
                Value="{x:Bind ViewModel.CurrentProgress, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ProgressBarVisibility, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"/>
            <Button
                Content="Start import"
                Command="{x:Bind ViewModel.ImportCommand}"/>
            <TextBlock
                x:Name="ImportResultTextBlock" 
                Height="50"
                Text="{x:Bind ViewModel.ImportResult, Mode=OneWay}"/>
        </StackPanel>


    </Grid>
</Page>
