<Page
    x:Class="Aether.WPFApp.Views.OrderPage"
    Style="{DynamicResource MahApps.Styles.Page}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:properties="clr-namespace:Aether.WPFApp.Properties"
    xmlns:local="clr-namespace:Aether.WPFApp.ViewModels"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">

    <Page.DataContext>
        <local:OrderViewModel/>
    </Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Style="{StaticResource PageTitleStyle}"
            Margin="{StaticResource MediumLeftMargin}"
            Text="{x:Static properties:Resources.BlankPageTitle}" />
        <Grid
            Grid.Row="1"
            Margin="{StaticResource MediumLeftRightMargin}"
            Background="{DynamicResource MahApps.Brushes.Gray10}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel
                Orientation="Horizontal">
                <Button
                    x:Name="OpenFileDialogButton"
                    Grid.Row="0"
                    Click="OpenFileDialogButton_Click">
                    Open File
                </Button>

            </StackPanel>
            
            <DataGrid
                x:Name="OrderDataGrid"
                Grid.Row="1"
                ItemsSource="{Binding Orders}"
                AutoGenerateColumns="False"
                Margin="0, 0, 10, 0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order Id" Binding="{Binding ordernumber}"/>
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding username}"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding quantity}"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding total}"/>
                    <DataGridTextColumn Header="Order Date" Binding="{Binding date}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding status}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
