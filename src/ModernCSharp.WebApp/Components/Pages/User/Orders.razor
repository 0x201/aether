@page "/user/orders"
@attribute [Authorize]
@using ModernCSharp.WebApp.Services
@attribute [StreamRendering(true)]

@inject OrderingService OrderApi

<PageTitle>Order</PageTitle>
<SectionContent SectionName="page-header-title">Orders</SectionContent>
<OrdersRefreshOnStatusChange/>

<FluentDataGrid Items="@orders" Pagination="@pagination">
    <PropertyColumn Property="@(order => order.OrderNumber)" Sortable="true" />
    <PropertyColumn Property="@(order => order.Date)" Sortable="true" />
    <PropertyColumn Property="@(order => order.Status)" Sortable="true" />
    <PropertyColumn Property="@(order => order.Quantity)" Sortable="true" />
    <PropertyColumn Property="@(order => order.Total)" Sortable="true" />
</FluentDataGrid>
<FluentPaginator State="@pagination" />

@code {
    PaginationState pagination = new PaginationState() { ItemsPerPage = 10 };

    private IQueryable<OrderRecord>? orders;

    protected override async Task OnInitializedAsync()
    {
        orders = (await OrderApi.GetOrders()).AsQueryable();
    }
}
