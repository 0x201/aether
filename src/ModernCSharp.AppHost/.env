# Container image name for danmakuanalytics
DANMAKUANALYTICS_IMAGE=danmakuanalytics:latest

# Container image name for danmakuviewer
DANMAKUVIEWER_IMAGE=danmakuviewer:latest

# Container image name for dydanmakuapi
DYDANMAKUAPI_IMAGE=dydanmakuapi:latest

# Default container port for dydanmakuapi
DYDANMAKUAPI_PORT=5000

# Bind mount source for eventbus:/var/lib/rabbitmq
EVENTBUS_BINDMOUNT_0=D:/dockerdata/rabbitmq/

# Parameter eventbus-password
EVENTBUS_PASSWORD=Pass123$

# Bind mount source for keycloak:/opt/keycloak/data/import
KEYCLOAK_BINDMOUNT_0=D:/dockerdata/keycloak/data

# Bind mount source for keycloak:/opt/keycloak/data/import
KEYCLOAK_BINDMOUNT_1=D:/dockerdata/keycloak/data/import

# Parameter keycloak-password
KEYCLOAK_PASSWORD=Pass123$

# Container image name for orderingapi
ORDERINGAPI_IMAGE=orderingapi:latest

# Default container port for orderingapi
ORDERINGAPI_PORT=5004

# Container image name for orderprocessor
ORDERPROCESSOR_IMAGE=orderprocessor:latest

# Default container port for orderprocessor
ORDERPROCESSOR_PORT=5010

# Bind mount source for postgres:/var/lib/postgresql
POSTGRES_BINDMOUNT_0=D:/dockerdata/postgres/

# Parameter postgres-password
POSTGRES_PASSWORD=Pass123$

# Bind mount source for redis:/data
REDIS_BINDMOUNT_0=D:/dockerdata/redis/

# Parameter redis-password
REDIS_PASSWORD=Pass123$

# Container image name for webapp
WEBAPP_IMAGE=webapp:latest

# Default container port for webapp
WEBAPP_PORT=5008

