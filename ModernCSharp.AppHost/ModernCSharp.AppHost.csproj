<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="9.3.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>7b535cd2-6e8e-458d-88f7-279fe1570184</UserSecretsId>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog.API\Catalog.API.csproj" />
    <ProjectReference Include="..\Identity.API\Identity.API.csproj" />
    <ProjectReference Include="..\Ordering.API\Ordering.API.csproj" />
    <ProjectReference Include="..\OrderProcessor\OrderProcessor.csproj" />
    <ProjectReference Include="..\ModernCSharp.Web\ModernCSharp.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
    <PackageReference Include="Aspire.Hosting.MySql" />
    <PackageReference Include="Aspire.Hosting.Python" />
    <PackageReference Include="Aspire.Hosting.NodeJS" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.NodeJS.Extensions" />
  </ItemGroup>
  <Target Name="RestorePnpm" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <NestJsAppPackageJsons Include="..\ClientApp\nestjs-demo\package.json"/>
    </ItemGroup>
    <Message Importance="Normal" Text="Installing pnpm packages for %(NestJsAppPackageJsons.RelativeDir)" Condition="!Exists('%(NestJsAppPackageJsons.RootDir)%(NestJsAppPackageJsons.Directory)/node_modules')" />
    <Exec Command="pnpm install" WorkingDirectory="%(NestJsAppPackageJsons.RootDir)%(NestJsAppPackageJsons.Directory)" Condition="!Exists('%(NestJsAppPackageJsons.RootDir)%(NestJsAppPackageJsons.Directory)/node_modules')" />

    <ItemGroup>
      <ViteVueAppPackageJsons Include="..\ClientApp\vite-vue-app\package.json"/>
    </ItemGroup>
    <Message Importance="Normal" Text="Installing pnpm packages for %(ViteVueAppPackageJsons.RelativeDir)" Condition="!Exists('%(ViteVueAppPackageJsons.RootDir)%(ViteVueAppPackageJsons.Directory)/node_modules')" />
    <Exec Command="pnpm install" WorkingDirectory="%(ViteVueAppPackageJsons.RootDir)%(ViteVueAppPackageJsons.Directory)" Condition="!Exists('%(ViteVueAppPackageJsons.RootDir)%(ViteVueAppPackageJsons.Directory)/node_modules')" />

    <ItemGroup>
      <ViteReactAppPackageJsons Include="..\ClientApp\vite-react-app\package.json"/>
    </ItemGroup>
    <Message Importance="Normal" Text="Installing pnpm packages for %(ViteReactAppPackageJsons.RelativeDir)" Condition="!Exists('%(ViteReactAppPackageJsons.RootDir)%(ViteReactAppPackageJsons.Directory)/node_modules')" />
    <Exec Command="pnpm install" WorkingDirectory="%(ViteReactAppPackageJsons.RootDir)%(ViteReactAppPackageJsons.Directory)" Condition="!Exists('%(ViteReactAppPackageJsons.RootDir)%(ViteReactAppPackageJsons.Directory)/node_modules')" />

    <ItemGroup>
      <AngularAppPackageJsons Include="..\ClientApp\angular-app\package.json"/>
    </ItemGroup>
    <Message Importance="Normal" Text="Installing pnpm packages for %(AngularAppPackageJsons.RelativeDir)" Condition="!Exists('%(AngularAppPackageJsons.RootDir)%(AngularAppPackageJsons.Directory)/node_modules')" />
    <Exec Command="pnpm install" WorkingDirectory="%(AngularAppPackageJsons.RootDir)%(AngularAppPackageJsons.Directory)" Condition="!Exists('%(AngularAppPackageJsons.RootDir)%(AngularAppPackageJsons.Directory)/node_modules')" />
  </Target>
</Project>
