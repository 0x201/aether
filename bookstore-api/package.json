{
  "name": "bookstore-api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "trickyrat",
  "scripts": {
    "build": "nest build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "start": "cross-env NODE_ENV=local nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run test/app.e2e-spec.ts",
    "test:e2e:watch": "vitest watch test/app.e2e-spec.ts",
    "prepare": "husky",
    "migration:generate": "node scripts/generate-migration.mjs",
    "migration:run": "pnpx typeorm-ts-node-commonjs migration:run -d ./src/database/typeorm-migration.config.ts",
    "migration:revert": "pnpx typeorm-ts-node-commonjs migration:revert -d ./src/database/typeorm-migration.config.ts"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.0.0",
    "@grpc/grpc-js": "^1.14.3",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/typeorm": "^11.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.214.0",
    "@opentelemetry/instrumentation-grpc": "^0.214.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "amqplib": "^1.0.3",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "keycloak-connect": "^26.1.1",
    "moment": "^2.30.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@scalar/nestjs-api-reference": "^1.1.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.1",
    "husky": "^9.0.11",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "supertest": "^7.2.2",
